generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URI")
}

model User {
  id            String    @id @default(cuid())
  phoneNumber   String    @unique
  name          String?
  profileImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isVerified    Boolean   @default(false)
  authAttempts  AuthAttempt[]
  deviceConnections DeviceConnection[]
}

model AuthAttempt {
  id          String    @id @default(cuid())
  phoneNumber String
  user        User      @relation(fields: [phoneNumber], references: [phoneNumber])
  type        String    // "SEND_OTP" or "VERIFY_OTP"
  status      String    // "SUCCESS" or "FAILED"
  createdAt   DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  metadata    Json?     // Additional information about the attempt
}

model DeviceConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  deviceType    String    // e.g., "strava", "garmin", "apple-watch", "fitbit"
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  isConnected   Boolean   @default(false)
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // deviceData    DeviceData[]

  @@unique([userId, deviceType])
}

